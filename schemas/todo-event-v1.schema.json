{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ericson-j-santos/chatgpt-operational-rules/schemas/todo-event-v1.schema.json",
  "title": "TodoEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "correlation_id",
    "idempotency_key",
    "project",
    "todo"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "enum": [
        "todo.created",
        "todo.updated",
        "todo.status.changed",
        "todo.evidence.updated",
        "todo.reconcile.requested"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "todo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "type",
        "status"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDENTE",
            "EM ANDAMENTO",
            "BLOQUEADO",
            "CONCLUÍDO",
            "CANCELADO"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            null
          ]
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "completion_criteria": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        },
        "evidence_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "e2e_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "N/A",
            "PENDENTE",
            "PARCIAL",
            "VALIDADO",
            "BLOQUEADO",
            null
          ]
        },
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "origin_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "CONCLUÍDO"}
            },
            "required": ["status"]
          },
          "then": {
            "required": ["completion_criteria", "evidence"],
            "properties": {
              "completion_criteria": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "BLOQUEADO"}
            },
            "required": ["status"]
          },
          "then": {
            "required": ["blocker", "next_action"],
            "properties": {
              "blocker": {"type": "string", "minLength": 1},
              "next_action": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
