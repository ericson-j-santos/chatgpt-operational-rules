FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY services/todo_gateway/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY services /app/services
COPY scripts /app/scripts
COPY sql /app/sql

EXPOSE 8000

CMD ["python", "-m", "services.todo_gateway.service_main"]
