+                mod.inspect(self.root, require_metadata=False)
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/tests/test_recover_noteri_gateway_journal_50227f_candidate.py b/tests/test_recover_noteri_gateway_journal_50227f_candidate.py
