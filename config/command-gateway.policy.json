{
  "version": 1,
  "allowed_roots": [
    "C:\\dev\\reqsys-v2-enterprise-real",
    "C:\\dev\\wt-*",
    "C:\\dev\\chatgpt-workers\\*"
  ],
  "denied_roots": ["%USERPROFILE%"],
  "denied_segments": [".ssh", ".azure", ".aws", ".gnupg", ".kube"],
  "denied_names": [".env", ".env.*", "id_rsa", "id_ed25519", "*.pem", "*.pfx", "*.p12"],
