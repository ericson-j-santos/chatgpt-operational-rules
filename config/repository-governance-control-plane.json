{
  "schema_version": 1,
  "repositories": [
    {
      "repository": "ericson-j-santos/reqsys-v2-enterprise-real",
      "visibility": "public",
      "mode": "enforce",
      "default_branch": "main",
      "require_branch_protection": true,
      "require_up_to_date": true,
      "required_workflows": [
        "Governed Merge Queue",
        "PR Evidence Gate",
        "Pre-PR Readiness Gate",
        "CI — ReqSys v2 Enterprise"
      ],
      "remediation": {
        "update_branch": true,
        "direct_merge": false,
        "merge_queue": {
          "enabled": true,
          "workflow": "governed-merge-queue.yml",
          "ref": "main",
          "pr_input": "pr_number"
        },
        "branch_protection": "report_only"
      }
    },
    {
